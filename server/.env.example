# =============================================================================
# DocBook — Doctor Appointment Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# 🔴 REQUIRED for production
# 🟡 REQUIRED for full functionality (optional for local dev)
# 🟢 Optional (has safe fallbacks)
# =============================================================================

# --- Server (🔴) ---
PORT=3000
NODE_ENV=development

# --- Database (🔴) ---
# Get these from your Neon dashboard: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- JWT (🔴) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis (🟡) ---
# Used for OTP storage with TTL. Falls back to in-memory Map if unset/unavailable.
REDIS_URL=redis://localhost:6379

# --- Email Provider (🟡) ---
# Used for OTP verification, resend OTP, and forgot password emails.
#
# 🔴 PRODUCTION: Brevo HTTP API (recommended — bypasses SMTP port issues)
#   EMAIL_PROVIDER=brevo
#   BREVO_API_KEY=<Brevo API key (not SMTP key)>
#   EMAIL_FROM=<Brevo verified sender email>
#   EMAIL_FROM_NAME=DocBook
#
#   ⚠️ Brevo Security:
#   If Brevo shows "Unauthorized IP addresses are blocked for API/SMTP keys",
#   go to Brevo → Settings → SMTP & API → Security → disable IP blocking
#   for beta testing, or add Railway outbound IPs.
#
# 🟢 LOCAL DEV: Gmail SMTP works for dev/testing (set EMAIL_PROVIDER=smtp)
#   Gmail SMTP times out from Railway/cloud — do NOT use in production.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@docbook.com
EMAIL_FROM_NAME=DocBook
SMTP_TEST_TO=you@example.com

# --- Production Admin Bootstrap (manual only) ---
# Used by: npm run admin:upsert
# Never commit real admin passwords.
ADMIN_EMAIL=[EMAIL_ADDRESS]
ADMIN_PASSWORD=replace-with-a-secure-12-plus-character-password
ADMIN_NAME=Production Admin
ADMIN_PHONE=

# --- Demo Seed Safety (local/staging only) ---
# Production seed is blocked unless explicitly set to true.
ALLOW_DEMO_SEED=false

# --- Stripe (🟡) ---
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- PayFast (🟡) ---
PAYFAST_API_KEY=your-payfast-api-key
PAYFAST_SECRET_KEY=your-payfast-secret-key
PAYFAST_BASE_URL=https://api.payfast.pk/v1

# --- Agora Video Calls (🟡) ---
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-certificate

# --- Firebase Push Notifications (🟢) ---
# Firebase is optional. Current in-app notifications work without it.
# Future server-side push notifications will use the Admin SDK service account.
# Legacy FCM server key (kept for backward compatibility):
FIREBASE_SERVER_KEY=your-firebase-server-key
# Future: Base64-encoded Firebase Admin SDK service account JSON.
# Export with: cat firebase-service-account.json | base64
# NEVER commit the raw service account JSON to version control.
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCI...==

# --- Frontend URLs (🟡) ---
# Comma-separated list of allowed CORS origins (production).
# In development mode, all origins are allowed.
FRONTEND_URL=http://localhost:8080
