# =============================================================================
# DocBook — Doctor Appointment Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# 🔴 REQUIRED for production
# 🟡 REQUIRED for full functionality (optional for local dev)
# 🟢 Optional (has safe fallbacks)
# =============================================================================

# --- Server (🔴) ---
PORT=3000
NODE_ENV=development

# --- Database (🔴) ---
# Get these from your Neon dashboard: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- JWT (🔴) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis (🟡) ---
# Used for OTP storage with TTL. Falls back to in-memory Map if unset/unavailable.
REDIS_URL=redis://localhost:6379

# --- Email / SMTP (🟡) ---
# Used for sending OTP verification emails. Falls back to console.log in dev.
# Gmail App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@docbook.com

# --- Stripe (🟡) ---
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- PayFast (🟡) ---
PAYFAST_API_KEY=your-payfast-api-key
PAYFAST_SECRET_KEY=your-payfast-secret-key
PAYFAST_BASE_URL=https://api.payfast.pk/v1

# --- Agora Video Calls (🟡) ---
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-certificate

# --- Firebase Push Notifications (🟢) ---
# Firebase is optional. Current in-app notifications work without it.
# Future server-side push notifications will use the Admin SDK service account.
# Legacy FCM server key (kept for backward compatibility):
FIREBASE_SERVER_KEY=your-firebase-server-key
# Future: Base64-encoded Firebase Admin SDK service account JSON.
# Export with: cat firebase-service-account.json | base64
# NEVER commit the raw service account JSON to version control.
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCI...==

# --- Frontend URLs (🟡) ---
# Comma-separated list of allowed CORS origins (production).
# In development mode, all origins are allowed.
FRONTEND_URL=http://localhost:8080
